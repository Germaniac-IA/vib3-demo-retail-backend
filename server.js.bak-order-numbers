       JOIN plans p ON p.id = s.plan_id
       WHERE bc.id = $1 AND bc.client_id = $2 AND bc.deleted_at IS NULL
       AND (bc.status IS NULL OR bc.status = 'pending') AND bc.order_id IS NULL
       LIMIT 1`,
      [cycleId, req.user.client_id]
    );

